# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password"
SESSION_SECRET="your-32-byte-base64-secret"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Google AdSense Monetization & Site Verification (Public Client & Slot IDs)
# Required for AdSense site verification and to enable ads on articles where allowAds=true
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXX"

# Optional: Specific Ad Unit IDs created in Google AdSense Dashboard (Ads -> By ad unit -> Display ads)
NEXT_PUBLIC_ADSENSE_SLOT_TOP="XXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM="XXXXXXXXXX"
