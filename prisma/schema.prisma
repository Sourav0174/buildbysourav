generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  tagline     String
  overview    String @db.Text
  whyItExists String @db.Text

  heroImage String?
  color     String  @default("#000000")
  status    String  @default("LIVE")
  timeline  String  @default("")

  tech                  Json @default("[]") // Array of strings
  features              Json @default("[]") // Array of strings
  roadmap               Json @default("[]") // Array of strings
  engineeringChallenges Json @default("[]") // Array of { title, description }
  engineeringDecisions  Json @default("[]") // Array of { title, description, tradeoff }
  metrics               Json @default("[]") // Array of { label, value }
  links                 Json @default("[]") // Array of { label, url }
  screenshots           Json @default("[]") // Array of { url, caption }
  seo                   Json @default("{}") // Object { title, description, keywords }

  isFeatured Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Settings {
  id          String   @id @default(cuid()) // We will only ever have one row
  siteName    String   @default("The Workspace")
  siteDesc    String   @default("A premium software engineering portfolio.")
  resumeUrl   String?
  githubUrl   String?
  twitterUrl  String?
  linkedinUrl String?
  email       String?
  phone       String?
  techStack   Json     @default("[]")
  updatedAt   DateTime @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  who          String   @db.Text
  deliverables Json     @default("[]")
  tech         Json     @default("[]")
  products     Json     @default("[]")
  color        String   @default("#ffffff")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  year        String
  title       String
  description String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("") @db.Text
  content         String    @default("") @db.Text
  coverImage      String?

  // Category relation
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Taxonomy & Author
  tags            Json      @default("[]") // Array of strings
  authorName      String    @default("Sourav")
  authorRole      String    @default("Full-Stack Engineer & Product Builder")
  authorAvatar    String    @default("/profile2.png")

  // Publication & Ordering
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  publishedAt     DateTime?
  readingTime     String    @default("1 min read")
  order           Int       @default(0)

  // Technical SEO & Social Graph
  seoTitle        String?
  seoDescription  String?   @db.Text
  ogImage         String?
  canonicalUrl    String?

  // Monetization & Cross-Links
  allowAds        Boolean   @default(false)
  relatedProduct  String?
  relatedService  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([isPublished, isFeatured])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


